[sub_resource type="GDScript" id="GDScript_86xau"]
script/source = "extends StaticBody3D

@export var player_node: Node3D
@onready var liquid_mesh: MeshInstance3D = $LiquidCylinder

@export_group(\"Slosh Physics\")
@export var mouse_sensitivity: float = 0.003
@export var max_slosh_angle: float = 0.6
@export var slosh_speed: float = 12.0
@export var recovery_speed: float = 6.0

var liquid_material: ShaderMaterial
var target_slosh: Vector2 = Vector2.ZERO
var current_slosh: Vector2 = Vector2.ZERO

func _ready() -> void:
	if liquid_mesh and liquid_mesh.get_active_material(0):
		liquid_material = liquid_mesh.get_active_material(0) as ShaderMaterial

func _unhandled_input(event: InputEvent) -> void:
	if event is InputEventMouseMotion:

		target_slosh.x -= event.relative.x * mouse_sensitivity
		target_slosh.y += event.relative.y * mouse_sensitivity
		

		target_slosh.x = clamp(target_slosh.x, -max_slosh_angle, max_slosh_angle)
		target_slosh.y = clamp(target_slosh.y, -max_slosh_angle, max_slosh_angle)

func _process(delta: float) -> void:
	if not liquid_material:
		return


	if player_node and \"current_health\" in player_node and \"max_health\" in player_node:
		var health_pct: float = float(player_node.current_health) / float(player_node.max_health)
		liquid_material.set_shader_parameter(\"health_ratio\", clamp(health_pct, 0.0, 1.0))


	target_slosh = target_slosh.move_toward(Vector2.ZERO, recovery_speed * delta)
	

	current_slosh = current_slosh.lerp(target_slosh, slosh_speed * delta)
	

	liquid_material.set_shader_parameter(\"slosh_angle\", current_slosh)
"

